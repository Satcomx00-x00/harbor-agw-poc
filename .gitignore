# Node
node_modules/
dist/
*.tsbuildinfo

# Compiled output is regenerated by scripts/40-mcp.sh; keeping it out of git
# stops a stale dist/ from being shipped to the cluster by mistake.

__pycache__/
*.pyc

# The only place secrets live.
lab.env

# Local overrides
*.local.yaml
.env

# The CA certificate is generated per install by scripts/00-prereqs.sh. It is
# not secret, but it is per-cluster, so committing one just means someone
# trusts the wrong root.
deploy/00-prereqs/lab-ca.crt

# Never
*.key
*.pem
kubeconfig
talosconfig
