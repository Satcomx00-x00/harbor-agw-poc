{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "mcp-harbor": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "mcp-openapi": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}
