# Copy to lab.env, or let scripts/init-secrets.sh generate one with random
# values. lab.env is gitignored and is the only place secrets live.
#
#     cp lab.env.example lab.env && $EDITOR lab.env
#     # or
#     ./scripts/init-secrets.sh

# Every hostname derives from this. Changing it here is not enough on its own -
# see "Moving the lab" in the README.
LAB_DOMAIN=192.168.1.200.nip.io

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Harbor's local admin. Stays usable for the API after the switch to OIDC,
# which is how scripts/20-harbor.sh configures OIDC in the first place.
HARBOR_ADMIN_PASSWORD=change-me

# Shared between the `harbor` client in the realm and Harbor's own OIDC config.
# The two must match or the authorization-code exchange fails with invalid_client.
HARBOR_OIDC_CLIENT_SECRET=change-me

# Realm users, used by the onboarding step and the smoke test.
LAB_USER_DEV_PASSWORD=change-me
LAB_USER_ALICE_PASSWORD=change-me
